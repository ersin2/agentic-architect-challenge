# Copy this file to .env and fill in ONE key. .env is git-ignored.

# Which provider to use: gemini | openai | fake
# If unset, the provider is chosen from whichever key is present; with no key, "fake" (offline) is used.
LLM_PROVIDER=gemini

# Optional model override. Defaults: gemini-3.5-flash-lite (Gemini), gpt-6-luna (OpenAI).
# LLM_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=
# OPENAI_API_KEY=

# Client-side rate limit in requests per minute (keeps a free-tier key under quota). 0 = unlimited.
LLM_RPM=8

# Logging: json (one JSON object per line on stderr) or text
LOG_FORMAT=json
LOG_LEVEL=INFO

# Part 2: a URL or email that identifies you in the scraper's User-Agent (some sites, e.g. Wikipedia,
# refuse requests without one). Defaults to this project's repository URL.
# SCRAPER_CONTACT=https://github.com/<you>/<repo>
